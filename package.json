    "@fastify/swagger-ui": "^3.0.0",
    "@types/pdfkit": "^0.17.6",
    "dotenv": "^16.4.5",
    "fastify": "^4.26.2",
    "pdf-parse": "^1.1.1",
    "pdf2json": "^3.1.3",
